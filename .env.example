# Generate a unique secret; never commit a real value.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=owner
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters

# Production must use managed PostgreSQL. SQLite is for local development only.
# Leave DATABASE_URL unset for the app-local SQLite file during local development.
# On production, set a managed PostgreSQL URL; the app explicitly uses psycopg 3.

COOKIE_SECURE=1
ADMIN_URL_PREFIX=/private-inbox

# International number. The app accepts +49..., 0049..., or 49... and normalizes it for wa.me.
# Use digits only in production where possible. Do not commit your real number.
WHATSAPP_NUMBER=0049XXXXXXXXXXX

# Increased from the previous 5/hour limit. Set to a valid Flask-Limiter rate string.
INTAKE_RATE_LIMIT=30 per hour
# memory:// is acceptable only for a single-instance free test deployment.
# Use persistent/shared Redis-compatible storage for multi-instance production.
RATELIMIT_STORAGE_URI=memory://
